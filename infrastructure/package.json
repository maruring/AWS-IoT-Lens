    "destroy-infra:dev": "cdk destroy Dev-iot-lens-Infra-Stack  -c environment=dev"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "aws-cdk": "2.173.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.173.4",
    "constructs": "^10.0.0"
  }
