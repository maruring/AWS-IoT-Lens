{
  "name": "infrastructure",
  "version": "0.1.0",
  "bin": {
    "infrastructure": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy-all:dev": "cdk deploy --all -c environment=dev",
    "deploy-infra:dev": "cdk deploy Dev-iot-lens-Infra-Stack  -c environment=dev",
